rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isEmailVerified() && request.auth.token.email == 'mayank2211005@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // --- Tournament ---
    function isValidTournament(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.status in ['league', 'playoffs', 'finished'];
    }

    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified() && isValidTournament(incoming()) && isValidId(tournamentId);
      allow update: if (isEmailVerified() && isValidTournament(incoming())) || isAdmin();
      allow delete: if isAdmin();

      match /teams/{teamId} {
        allow read: if isSignedIn();
        allow create: if isEmailVerified() && isValidId(teamId);
        allow update: if isEmailVerified() || isAdmin();
        allow delete: if isAdmin();

        match /squad/{playerId} {
          allow read: if isSignedIn();
          allow create: if isEmailVerified() && isValidId(playerId);
          allow update: if isEmailVerified() || isAdmin();
          allow delete: if isAdmin();
        }
      }

      match /matches/{matchId} {
        allow read: if isSignedIn();
        allow create: if isEmailVerified() && isValidId(matchId);
        allow update: if isEmailVerified() || isAdmin();
        allow delete: if isAdmin();
      }
    }
  }
}
